#!/usr/local/bin/perl -w
use strict;
use FindBin;
use CGI qw/:standard/;

$| = 1;
my $cgi = new CGI;
$cgi->charset('utf-8');

my $response = {};
$response->{result} = "ERROR";
$response->{message} = "ERROR: Unhandled exception E001";
my @tmp = ( 'Dataset service start' );
$response->{info} = \@tmp;

my $params;
my @parameters = qw ( test verbose action ID announcementXML filterstr outputMode detailLevel );


#### Extract CGI parameters
foreach my $parameter ( @parameters ) {
  if ($cgi->param($parameter)) {
    $params->{$parameter} = $cgi->param($parameter);
    push(@{$response->{info}},"Found input parameter $parameter=$params->{$parameter}") if ($cgi->param('verbose'));
  }
}

#### Also extract command-line parameters, useful for testing
foreach my $arg ( @ARGV ) {
  if ( $arg =~ /(\S+)=(\S+)/) {
    my $key = $1;
    my $value = $2;
    foreach my $parameter ( @parameters ) {
      if ($key eq $parameter) {
	$params->{$parameter} = $value;
	push(@{$response->{info}},"Found input parameter $key=$value");
      }
    }
  }# else {
  #  $response->{message} = "ERROR: Unable to parse method line parameter '$arg'\n";
  #  exit;
  #}
}

$response->{verbose} = $params->{verbose};
my $outputMode = $params->{outputMode} || 'html';

#### redirect here to new API//viewer so as to avoid unneeded CPU-costly imports
#
if ($outputMode =~ /html/i) {
  my $qs = '';
  if ($params->{ID} && $params->{ID} ne '') {
    $qs = "?pxid=$params->{ID}";
  }

  print "Status: 301 Moved Permanently\n";
  print "Location: https://proteomecentral.proteomexchange.org/ui$qs\n";
  print "\n";
  exit;
}
elsif ($outputMode =~ /json/i) {
  # only if we have an ID:
  if ($params->{ID} && $params->{ID} ne '') {
    print "Status: 301 Moved Permanently\n";
    print "Location: https://proteomecentral.proteomexchange.org/api/proxi/v0.1/datasets/$params->{ID}?src=GetDatasetRedirect&resultType=full\n";
    print "\n";
    exit;
  }
}
elsif ($outputMode =~ /xml/i) {
  # only if we have a filename (new param):
  if ($params->{announcementXML} && $params->{announcementXML} ne '') {
    my $filepath = "/local/wwwspecial/proteomecentral/var/submissions/$params->{announcementXML}";
    $filepath =~ s|\.\./||g;

    if ( -e "$filepath" ) {
      open (INFILE, "$filepath" ) || die("ERROR: Unable to open $filepath");
      print "Content-type: text/plain\n\n";
      while ( my $inline = <INFILE> ) {
	print $inline;
      }
      close(INFILE);
      exit;
    }
  }
}
#
#### fallback if we did not handle the request...


use lib "$FindBin::Bin/../lib/perl";
use XML::Writer;
use ProteomeXchange::Dataset;
use ProteomeXchange::DatasetParser;
use ProteomeXchange::ShowDataset;
use ProteomeXchange::DDIJS;
